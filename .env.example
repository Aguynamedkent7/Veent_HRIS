NODE_ENV="development"
PORT=3000

# ─── Discord time-tracking integration ───────────────────────────────────────
# Shared HMAC secret between the HRIS /api/v1/timesheets/log endpoint and the bot.
TIMELOG_API_SECRET="change-me-to-a-random-32-char-string"
# Discord bot (only needed to run `pnpm bot`, not the web app). Slash commands /in /out /break
# are registered to every guild the bot joins — no channel/guild id needed.
DISCORD_BOT_TOKEN=""
HRIS_API_URL="http://localhost:5173"
