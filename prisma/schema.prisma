generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Lucia Auth ──────────────────────────────────────────────────────────────

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@map("sessions")
}

// ─── Core HR Enums ───────────────────────────────────────────────────────────

enum Role {
  EMPLOYEE
  MANAGER
  HR_ADMIN
  SUPER_ADMIN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACTUAL
  PROBATIONARY
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  OFFBOARDED
}

enum RateType {
  MONTHLY
  DAILY
  HOURLY
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollRunStatus {
  DRAFT
  COMPUTED
  APPROVED
  VOIDED
}

enum PayFrequency {
  SEMI_MONTHLY
  MONTHLY
}

enum JobPostingStatus {
  DRAFT
  OPEN
  CLOSED
}

enum ApplicantStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum HolidayType {
  REGULAR
  SPECIAL_NON_WORKING
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGIN_FAILED
  PAYROLL_OVERRIDE
  LEAVE_OVERRIDE
}

// ─── Organization ─────────────────────────────────────────────────────────────

model Organization {
  id         String   @id @default(cuid())
  name       String   @db.VarChar(200)
  logoUrl    String?
  address    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  departments   Department[]
  users         User[]
  leaveTypes    LeaveType[]
  payrollConfig PayrollConfig?
  payrollRuns   PayrollRun[]
  jobPostings   JobPosting[]
  publicHolidays PublicHoliday[]
  auditLogs     AuditLog[]

  @@map("organizations")
}

// ─── Department ───────────────────────────────────────────────────────────────

model Department {
  id                 String      @id @default(cuid())
  organizationId     String
  name               String      @db.VarChar(200)
  parentDepartmentId String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  organization     Organization  @relation(fields: [organizationId], references: [id])
  parentDepartment Department?   @relation("DeptHierarchy", fields: [parentDepartmentId], references: [id])
  subDepartments   Department[]  @relation("DeptHierarchy")
  employees        Employee[]
  jobPostings      JobPosting[]

  @@unique([organizationId, name])
  @@map("departments")
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  organizationId String
  email          String    @unique
  passwordHash   String
  role           Role      @default(EMPLOYEE)
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  sessions     Session[]
  employee     Employee?
  auditLogs    AuditLog[]

  @@map("users")
}

// ─── Employee ─────────────────────────────────────────────────────────────────

model Employee {
  id                 String           @id @default(cuid())
  userId             String           @unique
  organizationId     String
  employeeNumber     String
  firstName          String
  lastName           String
  middleName         String?
  dateOfBirth        DateTime?
  gender             Gender?
  contactPhone       String?
  contactAddress     String?
  departmentId       String
  jobTitle           String
  employmentType     EmploymentType
  employmentStatus   EmploymentStatus @default(ACTIVE)
  startDate          DateTime
  endDate            DateTime?
  reportsToId        String?
  basicMonthlySalary Decimal          @db.Decimal(12, 2)
  rateType           RateType         @default(MONTHLY)
  sssNumber          String?
  philhealthNumber   String?
  pagibigNumber      String?
  tinNumber          String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user           User           @relation(fields: [userId], references: [id])
  department     Department     @relation(fields: [departmentId], references: [id])
  reportsTo      Employee?      @relation("EmployeeHierarchy", fields: [reportsToId], references: [id])
  directReports  Employee[]     @relation("EmployeeHierarchy")
  timesheets     Timesheet[]
  leaveBalances  LeaveBalance[]
  leaveRequests  LeaveRequest[]
  payrollEntries PayrollEntry[]
  convertedApplicant Applicant? @relation("ConvertedEmployee")

  @@unique([organizationId, employeeNumber])
  @@map("employees")
}

// ─── Timesheet ────────────────────────────────────────────────────────────────

model Timesheet {
  id              String          @id @default(cuid())
  employeeId      String
  periodStart     DateTime
  periodEnd       DateTime
  status          TimesheetStatus @default(DRAFT)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?
  totalHours      Decimal         @default(0) @db.Decimal(5, 2)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  employee   Employee          @relation(fields: [employeeId], references: [id])
  entries    TimesheetEntry[]

  @@unique([employeeId, periodStart])
  @@map("timesheets")
}

model TimesheetEntry {
  id          String    @id @default(cuid())
  timesheetId String
  date        DateTime
  hoursWorked Decimal   @db.Decimal(4, 2)
  notes       String?

  timesheet Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  @@map("timesheet_entries")
}

// ─── Leave ────────────────────────────────────────────────────────────────────

model LeaveType {
  id                  String   @id @default(cuid())
  organizationId      String
  name                String
  isPaid              Boolean  @default(true)
  defaultDaysPerYear  Decimal  @db.Decimal(5, 2)
  allowCarryOver      Boolean  @default(false)
  maxCarryOverDays    Decimal? @db.Decimal(5, 2)
  isActive            Boolean  @default(true)

  organization  Organization   @relation(fields: [organizationId], references: [id])
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]

  @@map("leave_types")
}

model LeaveBalance {
  id          String   @id @default(cuid())
  employeeId  String
  leaveTypeId String
  year        Int
  allocated   Decimal  @db.Decimal(5, 2)
  used        Decimal  @default(0) @db.Decimal(5, 2)
  remaining   Decimal  @db.Decimal(5, 2)

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id              String             @id @default(cuid())
  employeeId      String
  leaveTypeId     String
  startDate       DateTime
  endDate         DateTime
  totalDays       Decimal            @db.Decimal(5, 2)
  reason          String?
  status          LeaveRequestStatus @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@map("leave_requests")
}

// ─── Public Holidays ──────────────────────────────────────────────────────────

model PublicHoliday {
  id             String      @id @default(cuid())
  organizationId String
  date           DateTime
  name           String
  type           HolidayType
  year           Int

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("public_holidays")
}

// ─── Payroll ──────────────────────────────────────────────────────────────────

model PayrollConfig {
  id             String       @id @default(cuid())
  organizationId String       @unique
  payFrequency   PayFrequency @default(SEMI_MONTHLY)
  firstCutoff    Int?
  secondCutoff   Int?
  sssTable       Json
  philhealthRate Decimal      @db.Decimal(5, 4)
  philhealthFloor Decimal     @db.Decimal(10, 2)
  philhealthCeiling Decimal   @db.Decimal(10, 2)
  pagibigRate    Decimal      @db.Decimal(5, 4)
  pagibigCeiling Decimal      @db.Decimal(10, 2)
  birTaxTable    Json
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("payroll_configs")
}

model PayrollRun {
  id             String          @id @default(cuid())
  organizationId String
  periodStart    DateTime
  periodEnd      DateTime
  status         PayrollRunStatus @default(DRAFT)
  totalGross     Decimal         @default(0) @db.Decimal(14, 2)
  totalDeductions Decimal        @default(0) @db.Decimal(14, 2)
  totalNet       Decimal         @default(0) @db.Decimal(14, 2)
  hasOverride    Boolean         @default(false)
  overrideNote   String?
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id])
  entries      PayrollEntry[]

  @@unique([organizationId, periodStart, periodEnd])
  @@map("payroll_runs")
}

model PayrollEntry {
  id            String   @id @default(cuid())
  payrollRunId  String
  employeeId    String
  hoursWorked   Decimal  @db.Decimal(6, 2)
  basicPay      Decimal  @db.Decimal(12, 2)
  grossPay      Decimal  @db.Decimal(12, 2)
  sssEe         Decimal  @db.Decimal(10, 2)
  sssEr         Decimal  @db.Decimal(10, 2)
  philhealthEe  Decimal  @db.Decimal(10, 2)
  philhealthEr  Decimal  @db.Decimal(10, 2)
  pagibigEe     Decimal  @db.Decimal(10, 2)
  pagibigEr     Decimal  @db.Decimal(10, 2)
  withholdingTax Decimal @db.Decimal(10, 2)
  totalDeductions Decimal @db.Decimal(12, 2)
  netPay        Decimal  @db.Decimal(12, 2)
  isFlagged     Boolean  @default(false)
  flagReason    String?

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id])
  employee   Employee   @relation(fields: [employeeId], references: [id])

  @@map("payroll_entries")
}

// ─── Recruitment ──────────────────────────────────────────────────────────────

model JobPosting {
  id             String          @id @default(cuid())
  organizationId String
  departmentId   String
  title          String
  description    String          @db.Text
  status         JobPostingStatus @default(DRAFT)
  postedAt       DateTime?
  closedAt       DateTime?
  createdById    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  department   Department   @relation(fields: [departmentId], references: [id])
  applicants   Applicant[]

  @@map("job_postings")
}

model Applicant {
  id                   String         @id @default(cuid())
  jobPostingId         String
  firstName            String
  lastName             String
  email                String
  phone                String?
  resumeUrl            String?
  coverLetter          String?        @db.Text
  currentStage         ApplicantStage @default(APPLIED)
  convertedToEmployeeId String?       @unique
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  jobPosting        JobPosting            @relation(fields: [jobPostingId], references: [id])
  convertedEmployee Employee?             @relation("ConvertedEmployee", fields: [convertedToEmployeeId], references: [id])
  stageHistory      ApplicantStageHistory[]

  @@map("applicants")
}

model ApplicantStageHistory {
  id          String         @id @default(cuid())
  applicantId String
  stage       ApplicantStage
  notes       String?
  changedById String
  changedAt   DateTime       @default(now())

  applicant Applicant @relation(fields: [applicantId], references: [id])

  @@map("applicant_stage_history")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String
  actorId        String
  actorRole      Role
  action         AuditAction
  entityType     String
  entityId       String
  oldValue       Json?
  newValue       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User         @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}
